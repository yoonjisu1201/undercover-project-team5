--- !u!114 &1118275509955407839
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2710052251016005880}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>1. \uC228\uC740 \uC678\uACC4\uC778 \uC218\uC0C9\uD558\uAE30</b>\n\uC218\uC9D1\uB41C
    \uB2E8\uC11C\uB97C \uAE30\uBC18\uC73C\uB85C \uC758\uC2EC\uB418\uB294 \uC2DC\uBBFC\uC5D0\uAC8C
    \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00 \uC0C1\uD638\uC791\uC6A9\uD55C\uB2E4. \uC2DC\uBBFC\uC774\uBA74
    \uD0C0\uC774\uBA38\uAC00 2\uBD84 \uAC10\uC18C\uB41C\uB2E4.\n\n<b>2. \uC678\uACC4\uC778\uC758
    \uB3C4\uC8FC & \uD3EC\uD68D\uB3C4\uAD6C</b>\n\uC678\uACC4\uC778\uC774 \uB9DE\uC73C\uBA74
    \uB3C4\uC8FC\uD558\uAE30 \uC2DC\uC791\uD558\uACE0, \uBCF8\uBD80\uC5D0\uC11C \"\uC678\uACC4
    \uC0DD\uCCB4 \uC81C\uC555\uAE30\"\uB97C \uD68D\uB4DD\uD558\uC5EC \uD3EC\uD68D\uC744
    \uC9C4\uD589\uD55C\uB2E4.\n\n<b>3. \uD568\uAED8 \uC81C\uC555\uD558\uAE30</b>\n2\uBA85\uC774
    \uB300\uC0C1 \uC8FC\uBCC0\uC5D0\uC11C \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744
    \uB204\uB974\uACE0 \uC788\uC5B4\uC57C \uD55C\uB2E4.\n\uAC8C\uC774\uC9C0\uB97C
    \uCC44\uC6CC \uD3EC\uD68D\uC5D0 \uC131\uACF5\uD558\uBA70, \uB2E4\uC74C \uB77C\uC6B4\uB4DC\uB85C
    \uB118\uC5B4\uAC04\uB2E4."
