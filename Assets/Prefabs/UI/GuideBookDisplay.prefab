  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\uCCB4\uB825 \uAD00\uB9AC</b>\n\uD604\uC7A5\uC5D0\uC11C\uB294 \uC57D\uD654
    \uC2E0\uD638\uB85C \uC778\uD574 \uCCB4\uB825\uC774 \uC9C0\uC18D\uC801\uC73C\uB85C
    \uAC10\uC18C\uD558\uBA70, \uC678\uACC4\uC778 \uBCF5\uC81C\uCCB4\uAC00 \uC694\uC6D0\uC744
    \uACF5\uACA9\uD558\uAE30\uB3C4 \uD55C\uB2E4.\n\uCCB4\uB825\uC774 0\uC774 \uB418\uBA74
    \uB2E4\uC6B4\uB418\uBA70 \uB3D9\uB8CC\uC758 \uC18C\uC0DD\uC774 \uD544\uC694\uD558\uB2E4.\n\n<b>\uCCB4\uB825
    \uD68C\uBCF5\uACFC \uC548\uC804 \uAD6C\uC5ED</b>\n\uD68C\uBCF5 \uCE74\uD2B8 \uC8FC\uBCC0\uC5D0
    \uBA38\uBB3C\uBA74 \uCCB4\uB825\uC744 \uD68C\uBCF5\uD560 \uC218 \uC788\uB2E4.
    \uCE74\uD2B8\uB294 \uC774\uB3D9 \uAC00\uB2A5\uD558\uBA70 \uD68C\uBCF5\uB7C9\uC774
    \uC18C\uC9C4\uB418\uBA74 \uB9AC\uD544 \uD329\uC744 \uC774\uC6A9\uD574 \uBCF4\uCDA9\uD560
    \uC218 \uC788\uB2E4.\n\uBCF8\uBD80\uC5D0\uC11C\uB294 \uC790\uC5F0 \uCCB4\uB825
    \uC18C\uBAA8\uAC00 \uBA48\uCD98\uB2E4."
