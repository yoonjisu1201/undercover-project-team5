  m_text: "<b>1. \uBABD\uD0C0\uC8FC \uD654\uBA74 \uC5F4\uAE30</b>\\n\uBCF8\uBD80
    \uBAA8\uB2C8\uD130\uC5D0\uC11C [\uBABD\uD0C0\uC8FC] \uBA54\uB274\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4.\\n\\n<b>2.
    \uD2B9\uC9D5 \uC870\uD569\uD558\uAE30</b>\\n\uD5E4\uC5B4\xB7\uBAA8\uC790\xB7\uC548\uACBD\xB7\uB9C8\uC2A4\uD06C\xB7\uC0C1\uC758\xB7\uBC14\uC9C0
    \uB4F1\\n\uD604\uC7A5\uC774 \uC804\uB2EC\uD55C \uD2B9\uC9D5\uC5D0 \uB9DE\uB294
    \uD56D\uBAA9\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4.\\n\uAC19\uC740 \uD56D\uBAA9\uC744
    \uB2E4\uC2DC \uB204\uB974\uBA74 \uD574\uB2F9 \uD30C\uCE20\uAC00 \uC81C\uAC70\uB429\uB2C8\uB2E4.\\n\\n<b>3.
    \uD604\uC7A5\uC5D0 \uACF5\uC720\uD558\uAE30</b>\\n[\uBABD\uD0C0\uC8FC \uC804\uC1A1]\uC744
    \uB204\uB974\uBA74 \uD604\uC7A5\uC740 Tab\uC73C\uB85C \uD655\uC778\uD569\uB2C8\uB2E4.\\n\uC218\uC815\uC774
    \uD544\uC694\uD558\uBA74 [\uCD08\uAE30\uD654] \uD6C4 \uB2E4\uC2DC \uC870\uD569\uD558\uC138\uC694."
  m_isRightToLeft: 0
