  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>1. \uBC94\uC778 \uCD94\uACA9\uD558\uAE30</b>\\n\uBC94\uC778 \uD310\uC815
    \uD6C4 \uB3C4\uC8FC\uD558\uB294 \uB300\uC0C1\uC758 \uD45C\uC2DD\uC744 \uB530\uB77C\uAC11\uB2C8\uB2E4.\\n\\n<b>2.
    \uAC80\uAC70 \uB3C4\uAD6C \uC7A5\uCC29\uD558\uAE30</b>\\n\uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C
    \uAC80\uAC70 \uB3C4\uAD6C \uC2AC\uB86F\uC744 \uC120\uD0DD\uD569\uB2C8\uB2E4.\\n\uB3C4\uAD6C\uB97C
    \uC18C\uC9C0\uD558\uAE30\uB9CC \uD574\uC11C\uB294 \uAC80\uAC70\uC5D0 \uCC38\uC5EC\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\\n\\n<b>3. \uD568\uAED8 \uC81C\uC555\uD558\uAE30</b>\\n\uD604\uC7A5
    \uC694\uC6D0 2\uBA85\uC774 \uBC94\uC778 5m \uC548\uC5D0\uC11C\\n\uB9C8\uC6B0\uC2A4
    \uC67C\uCABD \uBC84\uD2BC\uC744 \uD568\uAED8 \uB204\uB974\uACE0 \uC788\uC5B4\uC57C
    \uD569\uB2C8\uB2E4.\\n\uC870\uAC74\uC774 \uB04A\uAE30\uBA74 \uAC8C\uC774\uC9C0\uAC00
    \uAC10\uC18C\uD558\uBA70,\\n100%\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uAC80\uAC70\uC5D0
    \uC131\uACF5\uD569\uB2C8\uB2E4."
