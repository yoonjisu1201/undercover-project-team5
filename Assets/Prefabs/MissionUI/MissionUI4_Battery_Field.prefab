    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>\uB808\uBC84\uB85C \uC804\uB825 \uB04A\uAE30</b>\n\uB808\uBC84\uB97C
    \uB0B4\uB9AC\uACE0 \uC788\uB294 \uB3D9\uC548 \uC804\uB825\uC774 \uCC28\uB2E8\uB429\uB2C8\uB2E4.\n<b>\uAC74\uC804\uC9C0\uB294
    \uC774\uB54C\uB9CC \uB123\uAC70\uB098 \uBE84 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</b>\n\n<b>\uB808\uBC84\uB97C
    \uC62C\uB824 \uCE21\uC815</b>\n\uC190\uC744 \uB5BC\uBA74 \uB808\uBC84\uAC00 \uC62C\uB77C\uAC00\uBA70
    \uC804\uB825\uC774 \uACF5\uAE09\uB418\uACE0 \uCE21\uC815\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4.\n\uC804\uB825\uC774
    \uB4E4\uC5B4\uC640 \uC788\uB294 \uB3D9\uC548\uC5D0\uB294 \uBC30\uCE58\uB97C \uBC14\uAFC0
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n<b>\uB2E4\uC2DC \uB9DE\uCD94\uAE30</b>\n\uC218\uCE58\uAC00
    \uB9DE\uC9C0 \uC54A\uC73C\uBA74 \uB808\uBC84\uB97C \uB2E4\uC2DC \uB0B4\uB824
    \uBC30\uCE58\uB97C \uACE0\uCE69\uB2C8\uB2E4.\n\uD569\uC774 \uBAA9\uD45C\uC640
    \uAC19\uC544\uC9C0\uB294 \uC21C\uAC04 \uBCF5\uAD6C\uAC00 \uB05D\uB0A9\uB2C8\uB2E4."
  m_isRightToLeft: 0
