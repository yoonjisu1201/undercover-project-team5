  m_text: "<b>\uC870\uC791</b>\n\u25B2\u25BC \uD55C \uBC88\uC5D0 2\uB3C4\uC529.\n\n<b>\uC9C0\uC2DC
    \uB4E3\uAE30</b>\n\xB7 \"\uC628\uB3C4 \uC62C\uB824\" \u2192 \u25B2\n\xB7 \"\uC628\uB3C4
    \uB0B4\uB824\" \u2192 \u25BC\n\xB7 \"\uC2A4\uD1B1\" \u2192 \uBA48\uCDA4\n\uD55C
    \uBC88 \uB204\uB974\uACE0 \uBC18\uC751\uC744 \uB4E4\uC73C\uC138\uC694.\n\n<b>\uC8FC\uC758</b>\n\uC628\uB3C4\uB97C
    \uB9DE\uCD98 \uB4A4\uC5D0\uB3C4 \uC870\uAE08\uC529 \uBCC0\uB3D9\uC774 \uC788\uC73C\uB2C8
    \uD654\uBA74\uC744 \uBCF4\uACE0 \uACC4\uC138\uC694."
