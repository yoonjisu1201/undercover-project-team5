      m_Calls: []
  m_text: "<b>\uAC8C\uC774\uC9C0 \uC77D\uAE30</b>\n\uBC14\uB298\uC774 \uB05D\uAE4C\uC9C0
    \uCC28\uBA74 \uBAA9\uD45C \uC804\uB825\uACFC \uC77C\uCE58\uD569\uB2C8\uB2E4.\n\uBAA9\uD45C
    \uC218\uCE58\uB294 \uD45C\uC2DC\uB418\uC9C0 \uC54A\uC73C\uB2C8 \uBC14\uB298 \uC704\uCE58\uB85C\uB9CC
    \uD310\uB2E8\uD558\uC138\uC694.\n\n<b>\uBC14\uB298\uC774 \uC6C0\uC9C1\uC774\uB294
    \uB54C</b>\n\uBC30\uD130\uB9AC \uB2F4\uB2F9\uC774 \uD655\uC778\uC744 \uB204\uB978
    \uC21C\uAC04\uC5D0\uB9CC 0\uC5D0\uC11C \uC62C\uB77C\uAC11\uB2C8\uB2E4.\n\uB808\uBC84\uB97C
    \uB0B4\uB824 \uC804\uC6D0\uC744 \uB044\uBA74 \uB2E4\uC2DC 0\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4.\n\n<b>\uD604\uC7A5\uC5D0
    \uC54C\uB824\uC904 \uAC83</b>\n\uC804\uB825 \uBCF5\uAD6C \uD544\uC694 \u2192
    \uB354 \uD070 \uAC74\uC804\uC9C0\uB85C \uAD50\uCCB4\n\uC804\uB825 \uCD08\uACFC
    \u2192 \uAC74\uC804\uC9C0\uB97C \uBE7C\uAC70\uB098 \uC791\uC740 \uAC83\uC73C\uB85C
    \uAD50\uCCB4\n\uC804\uB825 \uCDA9\uC871 \u2192 \uADF8\uB300\uB85C \uD655\uC815"
  m_isRightToLeft: 0
