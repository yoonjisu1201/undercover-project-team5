  - m_Id: 14780126544781486
    m_Localized: "\uac01 \ubd84\uc2e4\ubb3c\uc744 \uc62c\ubc14\ub974\uac8c \ubd84\ub958\ud558\uc5ec \ub2e8\uc11c\ub97c \ud68d\ub4dd\ud558\uc138\uc694."
