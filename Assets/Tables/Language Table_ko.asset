  - m_Id: 14780126544781525
    m_Localized: "\uBAA9\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781526
    m_Localized: "\uBB34\uC791\uC704 \uC18C\uD3EC\uB97C \uC9C0\uC815\uB41C \uBAA9\uC801\uC9C0
      \uBCF4\uAD00\uD568\uC73C\uB85C \uC62E\uAE30\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781527
    m_Localized: "\uBB34\uC791\uC704 \uBC30\uC1A1"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781528
    m_Localized: "\uC6B4\uBC18 \uC911: \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781529
    m_Localized: "\uC18C\uD3EC ID    PX-739\n\uCD9C\uBC1C \uBCF4\uAD00\uD568    B-03\n\uB3C4\uCC29
      \uBCF4\uAD00\uD568    D-01"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781530
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781531
    m_Localized: "\uACF5\uC911\uC804\uD654 \uC554\uD638 \uD574\uB3C5\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781532
    m_Localized: "<  \uB4A4\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781533
    m_Localized: "\uBAA9\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781534
    m_Localized: "\uBAA8\uC2A4 \uBD80\uD638\uB97C \uB4E3\uACE0 \uBCF8\uBD80\uC640
      \uC0C1\uC758\uD558\uC5EC \uC644\uC131\uB41C \uB2E8\uC5B4\uB97C \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781535
    m_Localized: "\uBCF8\uBD80 \uD574\uB3C5 \uBCF4\uACE0\uC11C"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781536
    m_Localized: "1. \uBCF8\uBD80\uC5D0 \uC5F0\uB77D\n2. \uC18C\uB9AC\uB97C \uBCF4\uACE0\n3.
      \uC601\uC5B4 \uB2E8\uC5B4 \uC644\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781537
    m_Localized: "\uC81C\uCD9C  -  \uB2E8\uC11C 100%"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781538
    m_Localized: "\uC601\uC5B4 \uB2E8\uC5B4 \uC785\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781539
    m_Localized: "\uC218\uD654\uAE30 \uC74C\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781540
    m_Localized: "[  \uC804\uD654 \uC218\uD654\uAE30  ]"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781541
    m_Localized: "\uC804\uCCB4 \uC18C\uB9AC\uB97C \uB4E4\uC73C\uC138\uC694.\n\uBAA8\uC2A4
      \uBD80\uD638\uD45C\uB294 \uBCF8\uBD80\uC5D0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781542
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781543
    m_Localized: "\uAD00\uCC30 \uBAA8\uB2C8\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781544
    m_Localized: "\uC218\uCE58\uB294 \uC548 \uBCF4\uC785\uB2C8\uB2E4. \uBC29\uD5A5\uB9CC
      \uBCF4\uACE0 \uC9C0\uC2DC\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781545
    m_Localized: "UNDERCOVER  \uD604\uC7A5 \uB9E4\uB274\uC5BC"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781546
    m_Localized: "\uAD00\uCC30 \uBAA8\uB2C8\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781547
    m_Localized: "<b>\uD654\uBA74 \uC77D\uAE30</b>\n \uCD08\uB85D  \uC9C0\uAE08 \uB9DE\uC74C\n
      \uB178\uB791  \uC62C\uB824\uC57C \uD568\n \uC8FC\uD669  \uB0B4\uB824\uC57C
      \uD568\n\n<b>\uC9C0\uC2DC</b>\n\uBCF8 \uAC83\uC744 \uADF8\uB300\uB85C \uB9D0\uD558\uC138\uC694.\n\"\uC628\uB3C4
      \uC62C\uB824\" / \"\uB18D\uB3C4 \uB0B4\uB824\" / \"\uC2A4\uD1B1\"\n\n<b>\uBAA9\uD45C</b>\n\uB458
      \uB2E4 \uC548\uC815\uD654\uC778 \uCC44\uB85C 4\uCD08. \uC218\uCE58\uB294 \uACC4\uC18D
      \uBCC0\uB3D9\uD558\uB2C8 \uADF8\uB3D9\uC548\uC5D0\uB3C4 \uC9C0\uC2DC\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781548
    m_Localized: "\uC628\uB3C4 \uC870\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781549
    m_Localized: "\uC815\uB2F5 \uBC94\uC704\uB294 \uBAA8\uB985\uB2C8\uB2E4. \uC9C0\uC2DC\uB97C
      \uB530\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781550
    m_Localized: "UNDERCOVER  \uD604\uC7A5 \uB9E4\uB274\uC5BC"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781551
    m_Localized: "\uC628\uB3C4 \uC870\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781552
    m_Localized: "<b>\uC870\uC791</b>\n \uD55C \uBC88\uC5D0 2\uB3C4\uC529.\n\n<b>\uC9C0\uC2DC
      \uB4E3\uAE30</b>\n \"\uC628\uB3C4 \uC62C\uB824\"  \n \"\uC628\uB3C4 \uB0B4\uB824\" 
      \n \"\uC2A4\uD1B1\"  \uBA48\uCDA4\n\uD55C \uBC88 \uB204\uB974\uACE0 \uBC18\uC751\uC744
      \uB4E4\uC73C\uC138\uC694.\n\n<b>\uC8FC\uC758</b>\n\uC628\uB3C4\uB97C \uB9DE\uCD98
      \uB4A4\uC5D0\uB3C4 \uC870\uAE08\uC529 \uBCC0\uB3D9\uC774 \uC788\uC73C\uB2C8
      \uD654\uBA74\uC744 \uBCF4\uACE0 \uACC4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781553
    m_Localized: "\uB18D\uB3C4 \uC870\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781554
    m_Localized: "\uC815\uB2F5 \uBC94\uC704\uB294 \uBAA8\uB985\uB2C8\uB2E4. \uC9C0\uC2DC\uB97C
      \uB530\uB974\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781555
    m_Localized: "UNDERCOVER  \uD604\uC7A5 \uB9E4\uB274\uC5BC"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781556
    m_Localized: "\uB18D\uB3C4 \uC870\uC808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781557
    m_Localized: "<b>\uC870\uC791</b>\n \uD55C \uBC88\uC5D0 2\uC529.\n\n<b>\uC9C0\uC2DC
      \uB4E3\uAE30</b>\n \"\uB18D\uB3C4 \uC62C\uB824\"  \n \"\uB18D\uB3C4 \uB0B4\uB824\" 
      \n \"\uC2A4\uD1B1\"  \uBA48\uCDA4\n<b>\"\uB18D\uB3C4\"</b>\uAC00 \uBD99\uC740
      \uB9D0\uC5D0\uB9CC \uC6C0\uC9C1\uC774\uC138\uC694.\n\n<b>\uC8FC\uC758</b>\n\uB18D\uB3C4\uB97C
      \uB9DE\uCD98 \uB4A4\uC5D0\uB3C4 \uC870\uAE08\uC529 \uBCC0\uB3D9\uC774 \uC788\uC73C\uB2C8
      \uD654\uBA74\uC744 \uBCF4\uACE0 \uACC4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781558
    m_Localized: "\uC624\uC5FC \uC0D8\uD50C \uBD84\uC11D \uBBF8\uC158"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781559
    m_Localized: "<  \uB4A4\uB85C"
    m_Metadata:
      m_Items: []
