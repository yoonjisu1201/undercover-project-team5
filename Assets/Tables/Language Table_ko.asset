      m_Items: []
  - m_Id: 14780126544781461
    m_Localized: "\uc804\ub825 \uac8c\uc774\uc9c0 \ud655\uc778"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781462
    m_Localized: "<b>\uac8c\uc774\uc9c0 \uc77d\uae30</b>\n\ubc14\ub298\uc774 \ub05d\uae4c\uc9c0 \ucc28\uba74 \ubaa9\ud45c \uc804\ub825\uacfc \uc77c\uce58\ud569\ub2c8\ub2e4.\n\ubaa9\ud45c \uc218\uce58\ub294 \ud45c\uc2dc\ub418\uc9c0 \uc54a\uc73c\ub2c8 \ubc14\ub298 \uc704\uce58\ub85c\ub9cc \ud310\ub2e8\ud558\uc138\uc694.\n\n<b>\ubc14\ub298\uc774 \uc6c0\uc9c1\uc774\ub294 \ub54c</b>\n\ubc30\ud130\ub9ac \ub2f4\ub2f9\uc774 \ud655\uc778\uc744 \ub204\ub978 \uc21c\uac04\uc5d0\ub9cc 0\uc5d0\uc11c \uc62c\ub77c\uac11\ub2c8\ub2e4.\n\ub808\ubc84\ub97c \ub0b4\ub824 \uc804\uc6d0\uc744 \ub044\uba74 \ub2e4\uc2dc 0\uc73c\ub85c \ub3cc\uc544\uac11\ub2c8\ub2e4.\n\n<b>\ud604\uc7a5\uc5d0 \uc54c\ub824\uc904 \uac83</b>\n\uc804\ub825 \ubcf5\uad6c \ud544\uc694  \ub354 \ud070 \uac74\uc804\uc9c0\ub85c \uad50\uccb4\n\uc804\ub825 \ucd08\uacfc  \uac74\uc804\uc9c0\ub97c \ube7c\uac70\ub098 \uc791\uc740 \uac83\uc73c\ub85c \uad50\uccb4\n\uc804\ub825 \ucda9\uc871  \uadf8\ub300\ub85c \ud655\uc815"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781463
    m_Localized: "\uc804\ub825 \uac8c\uc774\uc9c0"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781464
    m_Localized: "<- \ubaa9\ud45c \uc804\ub825"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781465
    m_Localized: "\ub808\ubc84\uac00 \ub0b4\ub824\uac00 \uc788\ub294 \ub3d9\uc548\ub9cc \uc804\ub825\uc774 \ud750\ub985\ub2c8\ub2e4. \ubc14\ub298 \uc704\uce58\ub97c \ud604\uc7a5\uc5d0 \uc804\ub2ec\ud574\uc8fc\uc138\uc694."
    m_Metadata:
      m_Items: []
