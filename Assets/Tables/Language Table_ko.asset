  - m_Id: 14780126544781523
    m_Localized: "\uc18c\ud3ec \ubcf4\uad00\ud568 \ubc30\uc1a1"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781524
    m_Localized: "<  \ub4a4\ub85c"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781525
    m_Localized: "\ubaa9\ud45c"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781526
    m_Localized: "\ubb34\uc791\uc704 \uc18c\ud3ec\ub97c \uc9c0\uc815\ub41c \ubaa9\uc801\uc9c0 \ubcf4\uad00\ud568\uc73c\ub85c \uc62e\uae30\uc138\uc694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781527
    m_Localized: "\ubb34\uc791\uc704 \ubc30\uc1a1"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781528
    m_Localized: "\uc6b4\ubc18 \uc911: \uc5c6\uc74c"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781529
    m_Localized: "\uc18c\ud3ec ID    PX-739\n\ucd9c\ubc1c \ubcf4\uad00\ud568    B-03\n\ub3c4\ucc29 \ubcf4\uad00\ud568    D-01"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781530
    m_Localized: "\ud655\uc778"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781531
    m_Localized: "\uacf5\uc911\uc804\ud654 \uc554\ud638 \ud574\ub3c5\uae30"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781532
    m_Localized: "<  \ub4a4\ub85c"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781533
    m_Localized: "\ubaa9\ud45c"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781534
    m_Localized: "\ubaa8\uc2a4 \ubd80\ud638\ub97c \ub4e3\uace0 \ubcf8\ubd80\uc640 \uc0c1\uc758\ud558\uc5ec \uc644\uc131\ub41c \ub2e8\uc5b4\ub97c \uc785\ub825\ud558\uc138\uc694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781535
    m_Localized: "\ubcf8\ubd80 \ud574\ub3c5 \ubcf4\uace0\uc11c"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781536
    m_Localized: "1. \ubcf8\ubd80\uc5d0 \uc5f0\ub77d\n2. \uc18c\ub9ac\ub97c \ubcf4\uace0\n3. \uc601\uc5b4 \ub2e8\uc5b4 \uc644\uc131"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781537
    m_Localized: "\uc81c\ucd9c  -  \ub2e8\uc11c 100%"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781538
    m_Localized: "\uc601\uc5b4 \ub2e8\uc5b4 \uc785\ub825"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781539
    m_Localized: "\uc218\ud654\uae30 \uc74c\uc131"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781540
    m_Localized: "[  \uc804\ud654 \uc218\ud654\uae30  ]"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781541
    m_Localized: "\uc804\uccb4 \uc18c\ub9ac\ub97c \ub4e4\uc73c\uc138\uc694.\n\ubaa8\uc2a4 \ubd80\ud638\ud45c\ub294 \ubcf8\ubd80\uc5d0 \uc788\uc2b5\ub2c8\ub2e4."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781542
    m_Localized: "\ud655\uc778"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781543
    m_Localized: "\uad00\ucc30 \ubaa8\ub2c8\ud130"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781544
    m_Localized: "\uc218\uce58\ub294 \uc548 \ubcf4\uc785\ub2c8\ub2e4. \ubc29\ud5a5\ub9cc \ubcf4\uace0 \uc9c0\uc2dc\ud558\uc138\uc694"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781545
    m_Localized: "UNDERCOVER  \ud604\uc7a5 \ub9e4\ub274\uc5bc"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781546
    m_Localized: "\uad00\ucc30 \ubaa8\ub2c8\ud130"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781547
    m_Localized: "<b>\ud654\uba74 \uc77d\uae30</b>\n \ucd08\ub85d  \uc9c0\uae08 \ub9de\uc74c\n \ub178\ub791  \uc62c\ub824\uc57c \ud568\n \uc8fc\ud669  \ub0b4\ub824\uc57c \ud568\n\n<b>\uc9c0\uc2dc</b>\n\ubcf8 \uac83\uc744 \uadf8\ub300\ub85c \ub9d0\ud558\uc138\uc694.\n\"\uc628\ub3c4 \uc62c\ub824\" / \"\ub18d\ub3c4 \ub0b4\ub824\" / \"\uc2a4\ud1b1\"\n\n<b>\ubaa9\ud45c</b>\n\ub458 \ub2e4 \uc548\uc815\ud654\uc778 \ucc44\ub85c 4\ucd08. \uc218\uce58\ub294 \uacc4\uc18d \ubcc0\ub3d9\ud558\ub2c8 \uadf8\ub3d9\uc548\uc5d0\ub3c4 \uc9c0\uc2dc\ud558\uc138\uc694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781548
    m_Localized: "\uc628\ub3c4 \uc870\uc808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781549
    m_Localized: "\uc815\ub2f5 \ubc94\uc704\ub294 \ubaa8\ub985\ub2c8\ub2e4. \uc9c0\uc2dc\ub97c \ub530\ub974\uc138\uc694"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781550
    m_Localized: "UNDERCOVER  \ud604\uc7a5 \ub9e4\ub274\uc5bc"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781551
    m_Localized: "\uc628\ub3c4 \uc870\uc808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781552
    m_Localized: "<b>\uc870\uc791</b>\n \ud55c \ubc88\uc5d0 2\ub3c4\uc529.\n\n<b>\uc9c0\uc2dc \ub4e3\uae30</b>\n \"\uc628\ub3c4 \uc62c\ub824\"  \n \"\uc628\ub3c4 \ub0b4\ub824\"  \n \"\uc2a4\ud1b1\"  \uba48\ucda4\n\ud55c \ubc88 \ub204\ub974\uace0 \ubc18\uc751\uc744 \ub4e4\uc73c\uc138\uc694.\n\n<b>\uc8fc\uc758</b>\n\uc628\ub3c4\ub97c \ub9de\ucd98 \ub4a4\uc5d0\ub3c4 \uc870\uae08\uc529 \ubcc0\ub3d9\uc774 \uc788\uc73c\ub2c8 \ud654\uba74\uc744 \ubcf4\uace0 \uacc4\uc138\uc694."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781553
    m_Localized: "\ub18d\ub3c4 \uc870\uc808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781554
    m_Localized: "\uc815\ub2f5 \ubc94\uc704\ub294 \ubaa8\ub985\ub2c8\ub2e4. \uc9c0\uc2dc\ub97c \ub530\ub974\uc138\uc694"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781555
    m_Localized: "UNDERCOVER  \ud604\uc7a5 \ub9e4\ub274\uc5bc"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781556
    m_Localized: "\ub18d\ub3c4 \uc870\uc808"
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781557
    m_Localized: "<b>\uc870\uc791</b>\n \ud55c \ubc88\uc5d0 2\uc529.\n\n<b>\uc9c0\uc2dc \ub4e3\uae30</b>\n \"\ub18d\ub3c4 \uc62c\ub824\"  \n \"\ub18d\ub3c4 \ub0b4\ub824\"  \n \"\uc2a4\ud1b1\"  \uba48\ucda4\n<b>\"\ub18d\ub3c4\"</b>\uac00 \ubd99\uc740 \ub9d0\uc5d0\ub9cc \uc6c0\uc9c1\uc774\uc138\uc694.\n\n<b>\uc8fc\uc758</b>\n\ub18d\ub3c4\ub97c \ub9de\ucd98 \ub4a4\uc5d0\ub3c4 \uc870\uae08\uc529 \ubcc0\ub3d9\uc774 \uc788\uc73c\ub2c8 \ud654\uba74\uc744 \ubcf4\uace0 \uacc4\uc138\uc694."
