    m_Localized: Listen to Morse code, consult HQ, and enter the completed word.
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781535
    m_Localized: HQ DECODING REPORT
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781536
    m_Localized: '1. CONTACT HQ

      2. REPORT THE SOUND

      3. COMPLETE THE
      ENGLISH WORD'
    m_Metadata:
