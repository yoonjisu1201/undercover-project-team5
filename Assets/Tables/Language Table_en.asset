    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781346
    m_Localized: 'The alien disguised as a civilian

      has been identified!'
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781347
    m_Localized: "\u25CF After voting ends, the result is shown before the window
      closes."
    m_Metadata:
      m_Items: []
  - m_Id: 14780126544781348
    m_Localized: All arrest votes for this round have been used.
    m_Metadata:
      m_Items: []
