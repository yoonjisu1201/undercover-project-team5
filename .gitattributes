# Unify line endings across OSes to stop Unity text assets from flapping
# between LF/CRLF depending on core.autocrlf. See issue #69.

* text=auto eol=lf

*.cs text eol=lf
*.json text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.renderTexture text eol=lf
*.mat text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.overrideController text eol=lf
*.mask text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.compute text eol=lf
